# Server
PORT=3000
LOOKUP_RATE_LIMIT=30
# Set only when deployed behind a trusted reverse proxy. Example: 1
# TRUST_PROXY=1

# Preferred: multiple custom licensed enrichment providers.
# Each URL must contain {phone}; it is replaced with the URL-encoded E.164 number.
# Keep this value in .env or a secret manager, never in committed source.
# LICENSED_PROVIDERS_JSON=[{"name":"Provider A","url":"https://provider-a.example/v1/lookup?phone={phone}","token":"secret-a"},{"name":"Provider B","url":"https://provider-b.example/lookup/{phone}","token":"secret-b"}]

# Backward-compatible single-provider configuration.
# LICENSED_PROVIDER_NAME=Example Licensed Provider
# LICENSED_PROVIDER_URL=https://provider.example/v1/lookup?phone={phone}
# LICENSED_PROVIDER_TOKEN=replace-with-secret

# Twilio Lookup v2.
# Explicitly enable it so adding credentials alone does not create billable lookups.
# TWILIO_LOOKUP_ENABLED=true
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=replace-with-secret
# Allowed fields: line_type_intelligence,caller_name,line_status
# Caller Name is US-only and may be billed per request; choose fields intentionally.
# TWILIO_LOOKUP_FIELDS=line_type_intelligence

# People Data Labs Person Identify.
# Only called for self/consented scopes; business lookups skip this adapter.
# PDL_IDENTIFY_ENABLED=true
# PDL_API_KEY=replace-with-secret
# Profiles below this match score are discarded. Allowed range 5..99.
# PDL_MIN_MATCH_SCORE=70
