# Server
PORT=3000
LOOKUP_RATE_LIMIT=30
# Set only when deployed behind a trusted reverse proxy. Example: 1
# TRUST_PROXY=1

# Preferred: multiple licensed enrichment providers.
# Each URL must contain {phone}; it is replaced with the URL-encoded E.164 number.
# Keep this value in .env or a secret manager, never in committed source.
# LICENSED_PROVIDERS_JSON=[{"name":"Provider A","url":"https://provider-a.example/v1/lookup?phone={phone}","token":"secret-a"},{"name":"Provider B","url":"https://provider-b.example/lookup/{phone}","token":"secret-b"}]

# Backward-compatible single-provider configuration.
# LICENSED_PROVIDER_NAME=Example Licensed Provider
# LICENSED_PROVIDER_URL=https://provider.example/v1/lookup?phone={phone}
# LICENSED_PROVIDER_TOKEN=replace-with-secret
